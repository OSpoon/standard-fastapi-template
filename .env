# General
PROJECT_NAME=API Service
API_VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=local

# Frontend
FRONTEND_HOST=http://localhost:5173

# Backend
BACKEND_CORS_ORIGINS="http://localhost,https://localhost"
SECRET_KEY=ABCDEFGHIJKLMNOPQRSTUVWXYZ123456
SUPERUSER=admin@example.com
SUPERUSER_PASSWORD=admin@123.

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=info@example.com

# Logging
LOG_FILE_PATH=service.log

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Idempotency
IDEMPOTENCY_KEY_HEADER="Idempotency-Key"
IDEMPOTENCY_LOCK_TTL_MS=30000
IDEMPOTENCY_RECORD_TTL_MS=3600000
IDEMPOTENCY_WAIT_TIMEOUT_MS=5000

# Docker
DOCKER_IMAGE_BACKEND=backend